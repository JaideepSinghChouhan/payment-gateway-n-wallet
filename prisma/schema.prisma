generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  wallet          Wallet?
  transactions    Transaction[]    @relation("initiatedTransactions")
  idempotencyKeys IdempotencyKey[]
  merchant        Merchant?
}

model Wallet {
  id             String     @id @default(uuid())
  userId         String?    @unique
  merchantId     String?    @unique
  balance        Decimal
  pendingBalance Decimal    @default(0)
  currency       String
  type           WalletType @default(USER)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation("MerchantWallet", fields: [merchantId], references: [id])

  createdAt     DateTime      @default(now())
  ledgerEntries LedgerEntry[]
}

model Transaction {
  id          String            @id @default(uuid())
  type        TransactionType
  status      TransactionStatus
  amount      Decimal
  currency    String
  referenceId String?           @unique
  createdAt   DateTime          @default(now())

  initiatorUserId String?
  orderId         String? @unique

  initiator User?         @relation("initiatedTransactions", fields: [initiatorUserId], references: [id])
  order     PaymentOrder? @relation(fields: [orderId], references: [id])

  refundedTransactionId String? //link to original
  ledgerEntries         LedgerEntry[]
}

model LedgerEntry {
  id            String    @id @default(uuid())
  transactionId String
  walletId      String
  entryType     EntryType
  amount        Decimal
  currency      String
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])
}

model IdempotencyKey {
  key         String
  userId      String
  endpoint    String
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([key, userId, endpoint])
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique
  flatFee   Decimal  @default(20)
  createdAt DateTime @default(now())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallet        Wallet?        @relation("MerchantWallet")
  paymentOrders PaymentOrder[]
}

model PaymentOrder {
  id         String             @id @default(uuid())
  merchantId String
  amount     Decimal
  currency   String
  status     PaymentOrderStatus @default(CREATED)
  createdAt  DateTime           @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  transaction Transaction?
}

/**
 * ENUMS
 */

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
}

enum TransactionType {
  P2P
  PAYMENT
  REFUND
  TOPUP
  WITHDRAWL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum WalletType {
  USER
  SYSTEM
  MERCHANT
}
